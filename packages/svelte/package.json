{
	"name": "flue-svelte",
	"version": "0.1.2",
	"description": "Community-maintained, unofficial Svelte 5 adapter for Flue conversations",
	"//": "Modified for community distribution: independent package identity and public SDK dependency; see NOTICE.",
	"type": "module",
	"license": "Apache-2.0",
	"homepage": "https://github.com/xvin-zr/flue",
	"repository": {
		"type": "git",
		"url": "https://github.com/xvin-zr/flue",
		"directory": "packages/svelte"
	},
	"bugs": {
		"url": "https://github.com/xvin-zr/flue/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.svelte.d.ts",
			"svelte": "./dist/index.svelte.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "tsdown",
		"check:types": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@flue/sdk": "2.0.5",
		"svelte": "^5.3.0"
	},
	"devDependencies": {
		"@flue/sdk": "2.0.5",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"happy-dom": "^20.11.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tsdown": "^0.22.7",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.6"
	}
}
